# Configuración de la aplicación
APP_NAME="Servicio de Despacho - Smart Ride"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8003

# Base de datos PostgreSQL 
DATABASE_URL=postgresql://usuario:password@postgres:5432/db_smartride_despacho
DB_HOST=postgres 
DB_PORT=5432      
DB_NAME=db_smartride_despacho
DB_USER=usuario
DB_PASSWORD=password

# RabbitMQ (nombre del servicio Docker)
RABBITMQ_HOST=rabbitmq 
RABBITMQ_PORT=5672      
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NUEVAS_RESERVAS=nueva_reserva
RABBITMQ_QUEUE_ASIGNACIONES=viaje_asignado
RABBITMQ_EXCHANGE=smart_ride_exchange

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Redis (nombre del servicio Docker)
REDIS_HOST=redis  
REDIS_PORT=6379    
REDIS_DB=0

# Configuración de logs
LOG_LEVEL=INFO
LOG_FORMAT=json

# Servicios externos (otros microservicios)
RIDE_SERVICE_GRPC_HOST=servicio-viajes
RIDE_SERVICE_GRPC_PORT=50052